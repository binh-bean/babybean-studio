# Normalise line endings. Agents run on different platforms and CI is Ubuntu;
# without this, whole files show up as changed just from a checkout.
* text=auto eol=lf

*.sh    text eol=lf
*.mjs   text eol=lf
*.sql   text eol=lf

# Never touch binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary

# Keep generated lockfile diffs out of review noise.
package-lock.json -diff linguist-generated
