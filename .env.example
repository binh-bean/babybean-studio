# ============ Supabase ============
# Supabase co HAI he ten khoa. Bien o day giu ten cu, gia tri thi tuy project:
#   he cu  : "anon public"  /  "service_role secret"   (chuoi JWT, bat dau bang eyJ)
#   he moi : "Publishable"  /  "Secret"                (sb_publishable_... / sb_secret_...)
# Ca hai deu chay voi @supabase/supabase-js. Vai tro Postgres khong doi:
# khach chua dang nhap van la `anon`, nhan vien dang nhap van la `authenticated`,
# va khoa bi mat van bo qua RLS. Cac policy trong db/policies.sql khong bi anh huong.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHi dung o server. KHONG BAO GIO expose ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Chuoi ket noi Postgres truc tiep. Chi dung cho script chay SQL/DDL
# (db:push, db:seed) va cho test RLS theo tung vai tro.
# Lay o: dashboard -> nut Connect -> Connection string -> URI.
# Neu ket noi truc tiep khong duoc thi chon "Session pooler" (ho tro IPv4).
# TUYET DOI khong dat chuoi cua bb-prod vao day.
SUPABASE_DB_URL=

# Noi db:backup ghi tep .sql ra. De trong thi mac dinh ../babybean-backups/.
# PHAI nam NGOAI kho: kho nay public, tep sao luu co ten va so dien thoai khach
# that. Script tu choi ghi vao trong kho, ke ca thu muc dang gitignore.
BACKUP_DIR=

# Mat khau mo/khoa tep sao luu da ma hoa (scripts/ma-hoa-sao-luu.mjs), it nhat
# 20 ky tu. KHONG dat trong .env.local/.env.prod.local — day la bi mat cua
# rieng lich sao luu tu dong (BB-273), chi dat trong GitHub Secrets
# (BACKUP_PASSPHRASE) va, khi giai ma tren may studio, go truc tiep vao dong
# lenh. Mat mat khau nay la mat vinh vien moi ban sao luu da ma hoa — khong co
# duong khoi phuc nao khac. Xem docs/24-sao-luu-tu-dong.md.
# BACKUP_PASSPHRASE=

# Chuoi ket noi Postgres rieng cho lich sao luu tu dong tren GitHub Actions.
# CHI dat trong GitHub Secrets voi ten BACKUP_DATABASE_URL, khong dat o day.
# Xem docs/24-sao-luu-tu-dong.md.
# BACKUP_DATABASE_URL=

# ============ Google Drive ============
# API key restricted: chi bat Drive API, gioi han theo HTTP referrer/IP cua server
GOOGLE_DRIVE_API_KEY=
# Phase 2: service account de doc Shared Drive on dinh hon
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ============ App ============
# Production: https://chon-anh.babybean.vn (xem docs/13-quyet-dinh-van-hanh.md §5)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret ky share token va session khach hang (openssl rand -base64 32)
APP_SECRET=
# Thoi han session khach hang sau khi nhap PIN (giay)
CUSTOMER_SESSION_TTL=604800

# ============ Rate limit (Upstash Redis - tuy chon) ============
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============ Lark (Phase 3) ============
LARK_APP_ID=
LARK_APP_SECRET=
LARK_WEBHOOK_URL=
LARK_BASE_APP_TOKEN=

# Khoá cho đường kéo Lark định kỳ (BB-152): POST /api/cron/sync-lark chỉ nhận
# đúng "Authorization: Bearer <giá trị này>". Không đặt thì route trả 401 mọi
# lượt gọi — cửa đóng đúng cách, nhưng tính năng chết im lặng.
# Phải đặt ở HAI chỗ: biến môi trường trên Vercel, và GitHub Secrets
# (cùng với APP_URL) cho .github/workflows/sync-lark.yml.
SYNC_CRON_SECRET=

# CHỈ DÙNG KHI CHẠY PHÉP THỬ — ĐỂ TRỐNG Ở MỌI NƠI KHÁC.
#
# `src/lib/lark/notify.ts` mặc định KHÔNG bắn tin khi đang chạy phép thử. Chốt
# đó sinh ra ngày 21/09/2026, sau khi một lượt `npm run test` đẩy sáu thẻ
# "Test BB114…" vào nhóm Lark THẬT của studio — bộ phép thử BB-114 gọi thật
# /api/g/submit trên bb-dev, với `settings` thật và webhook thật.
#
# Đặt `=1` chỉ mở chốt đó ra, và chỉ những bộ phép thử đã thay `fetch` bằng hàm
# giả mới được đặt — chúng kiểm hình dạng lượt gọi, không có gì ra khỏi máy.
# Đặt biến này trên Vercel là vô nghĩa — trên đó không ai chạy phép thử cả.
#
# Tên cũ `LARK_CHO_PHEP_GUI_TRONG_PHEP_THU` bỏ ngày 21/09/2026: BB-195 kéo thêm
# `driveFetch` và `sync-retouch` vào cùng chốt, nên một cái tên chỉ nói "LARK"
# là cái tên nói sai phạm vi.
CHO_PHEP_GOI_MANG_TRONG_PHEP_THU=

# Khoá cho lịch chạy của chính Vercel (BB-186). Đặt biến TÊN NÀY trên Vercel là
# Vercel tự gắn "Authorization: Bearer <giá trị>" vào mọi lượt cron nó gọi —
# tên biến do Vercel quy định, không đổi được.
#
# /api/cron/expire-galleries nhận CẢ HAI khoá: CRON_SECRET cho lượt Vercel tự
# gọi, SYNC_CRON_SECRET cho lúc gọi tay bằng curl. Thiếu cả hai thì route trả
# 401 mọi lượt — và lịch hết hạn link chết im lặng, đúng như trước BB-186.
CRON_SECRET=

# ============ Thông báo đẩy — Web Push (BB-246) ============
# Ba mẹ bật thông báo một lần trên màn khách, rồi nhận tin khi ảnh đã chỉnh
# xong, mời duyệt. Sinh cặp khoá bằng:
#   npx web-push generate-vapid-keys
# KHÔNG tạo khoá thật vào repo — chỉ dán vào .env.local / biến môi trường
# Vercel. Thiếu bất kỳ biến nào trong ba biến dưới đây thì tính năng tự tắt
# êm: không hiện nút, không gửi, không lỗi 500.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Bắt buộc dạng "mailto:..." — web-push dùng để tự giới thiệu với dịch vụ đẩy
# (FCM/APNs/Mozilla) khi có sự cố, theo chuẩn VAPID.
VAPID_SUBJECT=mailto:cskh@babybeanstudio.vn

# ============ Zalo ZNS (Phase 4) ============
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

# ============ Observability ============
SENTRY_DSN=
