# ============ Supabase ============
# Supabase co HAI he ten khoa. Bien o day giu ten cu, gia tri thi tuy project:
#   he cu  : "anon public"  /  "service_role secret"   (chuoi JWT, bat dau bang eyJ)
#   he moi : "Publishable"  /  "Secret"                (sb_publishable_... / sb_secret_...)
# Ca hai deu chay voi @supabase/supabase-js. Vai tro Postgres khong doi:
# khach chua dang nhap van la `anon`, nhan vien dang nhap van la `authenticated`,
# va khoa bi mat van bo qua RLS. Cac policy trong db/policies.sql khong bi anh huong.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# CHi dung o server. KHONG BAO GIO expose ra client.
SUPABASE_SERVICE_ROLE_KEY=

# Chuoi ket noi Postgres truc tiep. Chi dung cho script chay SQL/DDL
# (db:push, db:seed) va cho test RLS theo tung vai tro.
# Lay o: dashboard -> nut Connect -> Connection string -> URI.
# Neu ket noi truc tiep khong duoc thi chon "Session pooler" (ho tro IPv4).
# TUYET DOI khong dat chuoi cua bb-prod vao day.
SUPABASE_DB_URL=

# Noi db:backup ghi tep .sql ra. De trong thi mac dinh ../babybean-backups/.
# PHAI nam NGOAI kho: kho nay public, tep sao luu co ten va so dien thoai khach
# that. Script tu choi ghi vao trong kho, ke ca thu muc dang gitignore.
BACKUP_DIR=

# ============ Google Drive ============
# API key restricted: chi bat Drive API, gioi han theo HTTP referrer/IP cua server
GOOGLE_DRIVE_API_KEY=
# Phase 2: service account de doc Shared Drive on dinh hon
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# ============ App ============
# Production: https://chon-anh.babybean.vn (xem docs/13-quyet-dinh-van-hanh.md §5)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret ky share token va session khach hang (openssl rand -base64 32)
APP_SECRET=
# Thoi han session khach hang sau khi nhap PIN (giay)
CUSTOMER_SESSION_TTL=604800

# ============ Rate limit (Upstash Redis - tuy chon) ============
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============ Lark (Phase 3) ============
LARK_APP_ID=
LARK_APP_SECRET=
LARK_WEBHOOK_URL=
LARK_BASE_APP_TOKEN=

# Khoá cho đường kéo Lark định kỳ (BB-152): POST /api/cron/sync-lark chỉ nhận
# đúng "Authorization: Bearer <giá trị này>". Không đặt thì route trả 401 mọi
# lượt gọi — cửa đóng đúng cách, nhưng tính năng chết im lặng.
# Phải đặt ở HAI chỗ: biến môi trường trên Vercel, và GitHub Secrets
# (cùng với APP_URL) cho .github/workflows/sync-lark.yml.
SYNC_CRON_SECRET=

# ============ Zalo ZNS (Phase 4) ============
ZALO_OA_ID=
ZALO_ACCESS_TOKEN=
ZALO_ZNS_TEMPLATE_ID=

# ============ Observability ============
SENTRY_DSN=
